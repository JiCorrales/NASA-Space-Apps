# The team works on Windows and Linux: store text with LF so diffs stay clean.
* text=auto eol=lf

# Unity text assets
*.cs text diff=csharp
*.meta text
*.unity text
*.prefab text
# Not every .asset is YAML: baked lighting, NavMesh and terrain data are binary even with
# Force Text, and forcing "text" would rewrite CRLF byte pairs inside them. Let git detect it.
*.asset text=auto
*.mat text
*.anim text
*.controller text

# Binary assets: never touch their line endings
*.fbx binary
*.glb binary
*.blend binary
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.psd binary
*.exr binary
*.hdr binary
*.wav binary
*.mp3 binary
*.ogg binary
*.mp4 binary
*.ttf binary
*.otf binary
